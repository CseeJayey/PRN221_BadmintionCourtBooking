@page
@model BadmintonCourtBooking.Pages.EmployeePages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Employee</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Employee.EmployeeId" class="control-label"></label>
                <input asp-for="Employee.EmployeeId" class="form-control" />
                <span asp-validation-for="Employee.EmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.RoleId" class="control-label"></label>
                <select asp-for="Employee.RoleId" class ="form-control" asp-items="ViewBag.RoleId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Employee.FullName" class="control-label"></label>
                <input asp-for="Employee.FullName" class="form-control" />
                <span asp-validation-for="Employee.FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Username" class="control-label"></label>
                <input asp-for="Employee.Username" class="form-control" />
                <span asp-validation-for="Employee.Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.PasswordHash" class="control-label"></label>
                <input asp-for="Employee.PasswordHash" class="form-control" />
                <span asp-validation-for="Employee.PasswordHash" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Dob" class="control-label"></label>
                <input asp-for="Employee.Dob" class="form-control" />
                <span asp-validation-for="Employee.Dob" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.PhoneNumber" class="control-label"></label>
                <input asp-for="Employee.PhoneNumber" class="form-control" />
                <span asp-validation-for="Employee.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Status" class="control-label"></label>
                <input asp-for="Employee.Status" class="form-control" />
                <span asp-validation-for="Employee.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.CreatedDate" class="control-label"></label>
                <input asp-for="Employee.CreatedDate" class="form-control" />
                <span asp-validation-for="Employee.CreatedDate" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Employee.IsDeleted" /> @Html.DisplayNameFor(model => model.Employee.IsDeleted)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
