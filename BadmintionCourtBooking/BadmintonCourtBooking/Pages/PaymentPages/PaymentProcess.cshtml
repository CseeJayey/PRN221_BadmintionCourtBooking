@page
@model BadmintonCourtBooking.Pages.PaymentPages.PaymentProcessModel
@{
    ViewData["Title"] = "Process Payment";
}

<h2>Process Payment</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="ProcessPaymentDTO.PaymentId"></label>
        <input asp-for="ProcessPaymentDTO.PaymentId" class="form-control" />
        <span asp-validation-for="ProcessPaymentDTO.PaymentId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProcessPaymentDTO.BookingId"></label>
        <input asp-for="ProcessPaymentDTO.BookingId" class="form-control" />
        <span asp-validation-for="ProcessPaymentDTO.BookingId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProcessPaymentDTO.CustomerId"></label>
        <input asp-for="ProcessPaymentDTO.CustomerId" class="form-control" />
        <span asp-validation-for="ProcessPaymentDTO.CustomerId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProcessPaymentDTO.SumTotal"></label>
        <input asp-for="ProcessPaymentDTO.SumTotal" class="form-control" />
        <span asp-validation-for="ProcessPaymentDTO.SumTotal" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProcessPaymentDTO.Status"></label>
        <input asp-for="ProcessPaymentDTO.Status" class="form-control" />
        <span asp-validation-for="ProcessPaymentDTO.Status" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProcessPaymentDTO.PaymentMethod"></label>
        <input asp-for="ProcessPaymentDTO.PaymentMethod" class="form-control" />
        <span asp-validation-for="ProcessPaymentDTO.PaymentMethod" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Process Payment</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
