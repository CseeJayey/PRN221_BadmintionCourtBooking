@page
@model BadmintonCourtBooking.Pages.BookCourtPages.CourtCancelModel
@{
    ViewData["Title"] = "Cancel Booking";
}

<h2>Cancel Booking</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="BookingId"></label>
        <input asp-for="BookingId" class="form-control" />
        <span asp-validation-for="BookingId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-danger">Cancel Booking</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
