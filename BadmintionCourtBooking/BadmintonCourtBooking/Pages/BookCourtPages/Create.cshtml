@page
@model RazorPages.Pages.BookCourtPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Booking</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Booking.BookingId" class="control-label"></label>
                <input asp-for="Booking.BookingId" class="form-control" />
                <span asp-validation-for="Booking.BookingId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.CustomerId" class="control-label"></label>
                <select asp-for="Booking.CustomerId" class ="form-control" asp-items="ViewBag.CustomerId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Booking.CourtId" class="control-label"></label>
                <select asp-for="Booking.CourtId" class ="form-control" asp-items="ViewBag.CourtId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Booking.TimeSlotId" class="control-label"></label>
                <input asp-for="Booking.TimeSlotId" class="form-control" />
                <span asp-validation-for="Booking.TimeSlotId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.BookingType" class="control-label"></label>
                <input asp-for="Booking.BookingType" class="form-control" />
                <span asp-validation-for="Booking.BookingType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.TotalHours" class="control-label"></label>
                <input asp-for="Booking.TotalHours" class="form-control" />
                <span asp-validation-for="Booking.TotalHours" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.StartTime" class="control-label"></label>
                <input asp-for="Booking.StartTime" class="form-control" />
                <span asp-validation-for="Booking.StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.EndTime" class="control-label"></label>
                <input asp-for="Booking.EndTime" class="form-control" />
                <span asp-validation-for="Booking.EndTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.BookingDate" class="control-label"></label>
                <input asp-for="Booking.BookingDate" class="form-control" />
                <span asp-validation-for="Booking.BookingDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.Status" class="control-label"></label>
                <input asp-for="Booking.Status" class="form-control" />
                <span asp-validation-for="Booking.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.PeopleCount" class="control-label"></label>
                <input asp-for="Booking.PeopleCount" class="form-control" />
                <span asp-validation-for="Booking.PeopleCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.CreatedAt" class="control-label"></label>
                <input asp-for="Booking.CreatedAt" class="form-control" />
                <span asp-validation-for="Booking.CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.PhoneNumber" class="control-label"></label>
                <input asp-for="Booking.PhoneNumber" class="form-control" />
                <span asp-validation-for="Booking.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.ReservedDuration" class="control-label"></label>
                <input asp-for="Booking.ReservedDuration" class="form-control" />
                <span asp-validation-for="Booking.ReservedDuration" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Booking.IsDeleted" /> @Html.DisplayNameFor(model => model.Booking.IsDeleted)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
