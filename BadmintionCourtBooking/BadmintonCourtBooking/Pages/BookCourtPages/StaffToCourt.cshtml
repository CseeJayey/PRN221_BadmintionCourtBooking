@page
@model BadmintonCourtBooking.Pages.BookCourtPages.StaffToCourtModel
@{
    ViewData["Title"] = "Assign Staff to Court";
}

<h2>Assign Staff to Court</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="StaffToCourtDTO.StaffId"></label>
        <input asp-for="StaffToCourtDTO.StaffId" class="form-control" />
        <span asp-validation-for="StaffToCourtDTO.StaffId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StaffToCourtDTO.CourtId"></label>
        <input asp-for="StaffToCourtDTO.CourtId" class="form-control" />
        <span asp-validation-for="StaffToCourtDTO.CourtId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Assign</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
