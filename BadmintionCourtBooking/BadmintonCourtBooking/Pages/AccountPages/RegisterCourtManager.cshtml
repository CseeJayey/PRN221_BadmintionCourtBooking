@page
@model BadmintonCourtBooking.Pages.AccountPages.RegisterCourtManagerModel
@{
}
<h2>Register Employee Staff</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="EmployeeRegisterDTO.FullName"></label>
        <input asp-for="EmployeeRegisterDTO.FullName" class="form-control" />
        <span asp-validation-for="EmployeeRegisterDTO.FullName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EmployeeRegisterDTO.Username"></label>
        <input asp-for="EmployeeRegisterDTO.Username" class="form-control" />
        <span asp-validation-for="EmployeeRegisterDTO.Username" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EmployeeRegisterDTO.PasswordHash"></label>
        <input asp-for="EmployeeRegisterDTO.PasswordHash" class="form-control" type="password" />
        <span asp-validation-for="EmployeeRegisterDTO.PasswordHash" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EmployeeRegisterDTO.Dob"></label>
        <input asp-for="EmployeeRegisterDTO.Dob" class="form-control" />
        <span asp-validation-for="EmployeeRegisterDTO.Dob" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EmployeeRegisterDTO.PhoneNumber"></label>
        <input asp-for="EmployeeRegisterDTO.PhoneNumber" class="form-control" />
        <span asp-validation-for="EmployeeRegisterDTO.PhoneNumber" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}